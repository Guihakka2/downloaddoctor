{
  "name": "@guihakka2/downloaddoctor",
  "version": "0.1.0",
  "description": "Find broken downloads: unfinished files, truncated or corrupt zip/pdf/images, HTML error pages saved as files, checksum mismatches, duplicates. Read-only.",
  "type": "module",
  "bin": {
    "downloaddoctor": "bin/downloaddoctor.js"
  },
  "exports": "./src/index.js",
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "downloads",
    "checksum",
    "sha256",
    "zip",
    "corrupt",
    "duplicates",
    "verify",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guihakka2/downloaddoctor.git"
  },
  "license": "MIT"
}
